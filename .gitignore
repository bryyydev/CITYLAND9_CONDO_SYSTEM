# Secrets / local configuration (never commit real credentials)
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Client data — databases and their automatic backups stay on the client's machine only
*.db
*.db.*
*.sqlite
*.sqlite3
cityland_condo_web_before_import_*
*.before_v10_cleanup.bak
*.sql.gz
database/backups/

# Uploaded files (future local document storage)
backend/instance/
uploads/

# Frontend (future React/Vite app)
node_modules/
# frontend/dist/ is committed on purpose (PCs without Node.js); rebuild it before committing UI changes.

# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store

# Local test reports and screenshots
test-output/

# CityLand's own local database server data (client data - never in git)
database/mysql-data/
*.db-wal
*.db-shm
*.db-journal

# Application, service and backup logs (may contain usernames and client addresses)
logs/

# Test-PC packages (database/test_pc.py): data, never in git
database/test_packages/
/migration_data/