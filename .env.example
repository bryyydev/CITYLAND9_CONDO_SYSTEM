# CityLand 9 server configuration
# Copy this file to .env on the SERVER PC and edit the values.

# SQL Server example using Windows Authentication and SQL Server Express:
DATABASE_URL=mssql+pyodbc://@localhost%5CSQLEXPRESS/CityLand9?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# Flask web server - 0.0.0.0 allows other PCs on the LAN to connect.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0

# CHANGE THIS before production use.
SECRET_KEY=replace-this-with-a-long-random-secret
