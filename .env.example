# CityLand 9 Condo Management System — LOCAL / LAN configuration
# ---------------------------------------------------------------
# Copy this file to ".env" on the server PC and fill in the values.
# ".env" holds real secrets: it is excluded from git and must never be shared.
# Everything runs on the client's own computer or LAN; no cloud service is used.

# --- Flask ---------------------------------------------------------------------
FLASK_ENV=production
# 0.0.0.0 = reachable from other PCs on the LAN (http://192.168.x.x:5000)
# 127.0.0.1 = this computer only
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Never set to 1 on the production server (the debugger allows running code remotely).
FLASK_DEBUG=0
# REQUIRED: a long random value. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# --- Local MySQL / MariaDB -------------------------------------------------------
# Used by the new backend and by the tools in database/tools/.
# The database server should listen on 127.0.0.1 (same PC as Flask) or the LAN only.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cityland9
MYSQL_USER=cityland9_app
MYSQL_PASSWORD=your_password

# --- Legacy system database (current production) -------------------------------
# Leave DATABASE_URL unset to keep using the local SQLite file cityland_condo_web.db.
# Do NOT point the legacy app at MySQL until docs/migration.md step 6 is completed.
# DATABASE_URL=

# --- Optional: SOA email (SMTP) --------------------------------------------------
# Email is optional. The system works fully without it; only "Send SOA email" needs it.
# Host/port/sender are set in Rates & Rules > Email Delivery. The login below is used
# when the Rates & Rules password field is empty. A LAN mail server works too.
# SMTP_USERNAME=
# SMTP_PASSWORD=
