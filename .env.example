# CityLand 9 Condo Management System — server configuration (LOCAL / LAN)
# --------------------------------------------------------------------------
# Copy this file to ".env" in the project root on the server PC, then fill in the values.
# ".env" holds real secrets: it is excluded from git and must never be shared or emailed.
# Everything runs on the client's own computer and LAN; no cloud service is used.
# Full guide: docs/run-guide/01-PREREQUISITES_AND_ENV.md

# --- Mode ------------------------------------------------------------------------
# production (default when unset) or development. Development relaxes the SECRET_KEY check and
# allows the Flask development server; never set it on the client's server.
APP_ENV=production

# --- Web server --------------------------------------------------------------------
# 0.0.0.0 = reachable from other PCs on the LAN (http://192.168.x.x:5000); 127.0.0.1 = this PC only
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Number of Waitress worker threads.
WAITRESS_THREADS=8
# The Flask debugger runs only with APP_ENV=development AND FLASK_DEBUG=1 AND FLASK_HOST=127.0.0.1.
FLASK_DEBUG=0

# REQUIRED. At least 32 random characters; the server refuses to start with a placeholder.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs everyone out and makes the saved SMTP password unreadable (re-enter it).
SECRET_KEY=<generate-a-64-character-random-value>

# --- Sessions and sign-in ---------------------------------------------------------------
# Signed out after this many minutes without activity, and after this many hours in any case.
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# Set to 1 only when users reach the server over HTTPS (docs/run-guide/06-SECURITY.md).
SESSION_COOKIE_SECURE=0
# Only with an HTTPS reverse proxy on this PC: its address (e.g. 127.0.0.1). Its X-Forwarded-Proto /
# X-Forwarded-For headers are then trusted; from anyone else they are ignored.
# TRUSTED_PROXY=127.0.0.1
# Minimum password length (8-64) for new, reset and changed passwords.
PASSWORD_MIN_LENGTH=10
# After this many failed sign-ins for one account from one PC, wait this many minutes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- Database engine ---------------------------------------------------------------------
# mysql  -> CityLand's own MariaDB (normal setup)
# sqlite -> the old file cityland_condo_web.db (emergency rollback only)
DB_ENGINE=mysql

# --- CityLand's own MariaDB ------------------------------------------------------------------
# Folder that contains mysqld.exe / mysqldump.exe.
MYSQL_BIN_DIR=C:\xampp\mysql\bin
# The values below are ADDED AUTOMATICALLY (with strong random passwords) by:
#     .venv\Scripts\python.exe database\local_mysql.py init
# Leave them commented out before running init: init never overwrites an existing value.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
# MYSQL_DATABASE=cityland9
# MYSQL_USER=cityland9_app
# MYSQL_PASSWORD=<added-by-init>
# MYSQL_ROOT_PASSWORD=<added-by-init>
# MYSQL_DATA_DIR=<added-by-init>
# Schema changes (db_migrate.py) use a separate account; the app account above can only read and
# write data. Added by:  .venv\Scripts\python.exe database\local_mysql.py secure   (init runs it too)
# MYSQL_MIGRATE_USER=cityland9_app_migrate
# MYSQL_MIGRATE_PASSWORD=<added-by-secure>

# --- Uploads (Excel import) ----------------------------------------------------------------------
MAX_UPLOAD_MB=20
IMPORT_MAX_ROWS=50000
IMPORT_MAX_COLUMNS=200
IMPORT_MAX_UNCOMPRESSED_MB=200

# --- Logs and monitoring (http://<server>:5000/healthz and /readyz) -----------------------------
# logs\cityland9.log rotates at LOG_MAX_MB; LOG_BACKUPS old files are kept.
LOG_MAX_MB=10
LOG_BACKUPS=10
# /readyz reports "not ready" below this much free disk space.
DISK_MIN_FREE_GB=2

# --- Backups (databaseackup.py, run daily by the "CityLand9 Backup" scheduled task) ----------
# Scheduled backups older than this are deleted; the newest BACKUP_KEEP_MIN are always kept.
# Manual and before-migration backups are never deleted automatically.
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MIN=7
# Refuse to start a backup with less free space than this.
BACKUP_MIN_FREE_GB=2
# /readyz and the server log warn when the last good backup is older than this.
BACKUP_MAX_AGE_HOURS=26
# Strongly recommended: a second copy on another disk, USB drive or a LAN share, e.g. E:\CityLand9-Backups
# or \\OFFICE-PC\CityLand9-Backups (the SYSTEM account must be allowed to write there).
# BACKUP_COPY_DIR=

# --- Advanced: explicit database URL (normally unset) -----------------------------------------
# Overrides DB_ENGINE and MYSQL_* and disables the automatic database start.
# DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3307/cityland9?charset=utf8mb4

# --- Optional: SOA email (SMTP) --------------------------------------------------------------
# Host, port and sender are set in the app (Rates & Rules > Email Delivery). The password typed
# there is stored encrypted and never shown again. These are used only when it is left empty.
# SMTP_USERNAME=
# SMTP_PASSWORD=
