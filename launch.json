{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CityLand 9: Run (debug, auto-reload)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/run.py",
            "cwd": "${workspaceFolder}",
            "env": { "FLASK_DEBUG": "1", "FLASK_HOST": "127.0.0.1", "FLASK_PORT": "5000" },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "CityLand 9: Load TEST-* sample data",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/seed_test_data.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "CityLand 9: Run tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
